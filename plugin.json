{
  "id": "omaYoutubeDl",
  "name": "Oma YouTube DL",
  "description": "Search YouTube, preview streams, queue yt-dlp downloads, and create subtitles.",
  "version": "1.1.0",
  "author": "Tanvir Rahman",
  "license": "MIT",
  "icon": "smart_display",
  "type": "widget",
  "capabilities": [
    "dankbar-widget",
    "youtube-search",
    "media-download",
    "subtitles",
    "ipc"
  ],
  "component": "./OmaYoutubeWidget.qml",
  "settings": "./OmaYoutubeSettings.qml",
  "requires_dms": ">=1.6.0",
  "dependencies": [
    "yt-dlp",
    "ffmpeg"
  ],
  "permissions": [
    "settings_read",
    "settings_write",
    "process",
    "network"
  ]
}
